# =========================================================
# NOORA ERP - PRODUCTION DOCKER ENVIRONMENT
# =========================================================

# ---------------------------------------------------------
# Docker
# ---------------------------------------------------------

IMAGE_TAG=latest

FRONTEND_PORT=3000
BACKEND_PORT=4000


# =========================================================
# FRONTEND
# =========================================================

# Public URL of frontend
NEXT_PUBLIC_APP_URL=http://94.184.41.228:3000

# Public URL of NestJS backend, accessed by browser
NEXT_PUBLIC_EXTERNAL_API_URL=http://94.184.41.228:4000

# Next.js internal route handlers
NEXT_PUBLIC_INTERNAL_API_URL=/api

# Customer branding
NEXT_PUBLIC_CUSTOMER_LOGO=/images/customer-logo.png
NEXT_PUBLIC_CUSTOMER_NAME=Noora ERP

# OTP login UI
NEXT_PUBLIC_ENABLE_OTP_LOGIN=false


# =========================================================
# BACKEND - APPLICATION
# =========================================================

APP_NAME=noora-flow
APP_ENV=production
APP_PORT=4000

# Generate a strong random secret for production
APP_ENCRYPTION_SECRET=CHANGE_ME_APP_ENCRYPTION_SECRET


# =========================================================
# CUSTOMER PORTAL
# =========================================================

# MUST exactly match frontend origin
CUSTOMER_NAITCO_URL=http://94.184.41.228:3000


# =========================================================
# SWAGGER
# =========================================================

SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=CHANGE_ME_SWAGGER_PASSWORD


# =========================================================
# MONGODB
# =========================================================

MONGO_URI=mongodb://noora-mongo:27017

MONGO_USER=noora_admin
MONGO_PASS=CHANGE_ME_MONGO_PASSWORD
MONGO_DBNAME=noora_flow


# =========================================================
# REDIS
# =========================================================

REDIS_HOST=noora-redis
REDIS_PORT=6379
REDIS_DB_INDEX=2


# =========================================================
# ELASTICSEARCH
# =========================================================

ELASTIC_NODE=http://noora-elastic:9200

ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD

# Keep empty when using username/password authentication
ELASTIC_API_KEY=

ES_JAVA_OPTS=-Xms1g -Xmx1g


# =========================================================
# JWT
# =========================================================

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

JWT_ISSUER=noora-flow
JWT_AUDIENCE=noora-flow-users

# Backend expects expiry values in seconds
JWT_ACCESS_TOKEN_EXPIREIN=360000
JWT_REFRESH_TOKEN_EXPIREIN=8640000


# =========================================================
# ADMIN SEED
# =========================================================

ADMIN_PHONE=09120000000
ADMIN_PASSWORD=123456

# Prefer false on production.
# Run npm run seed manually if needed.
SEED_ADMIN_ON_STARTUP=false


# =========================================================
# FEATURE FLAGS
# =========================================================

OTP_LOGIN_ENABLED=false


# =========================================================
# BPMN
# =========================================================

BPMN_DEFINITIONS_PATH=
BPMN_TEMPLATE_PATH=


# =========================================================
# INTEGRATIONS
# =========================================================

SEPIDAR=CHANGE_ME_SEPIDAR_KEY
COMPANY_DISPATCHER_TYPE=14
ALLOWED_IPS_PERSONNEL=

SMS_API_KEY=CHANGE_ME_SMS_API_KEY
SMS_URI=https://CHANGE_ME_SMS_PROVIDER_URI

RASMIO_API_KEY=
RASMIO_URL=

CURRENCY_API_KEY=
CURRENCY_API_URL=

RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=


# =========================================================
# BANK GATEWAY
# =========================================================

IKC_PUBLIC_KEY=CHANGE_ME_IKC_PUBLIC_KEY
TERMINAL_ID=CHANGE_ME_TERMINAL_ID
ACCEPTOR_ID=CHANGE_ME_ACCEPTOR_ID
REVERT_URI=https://CHANGE_ME_REVERT_URI
PASS_PHRASE=CHANGE_ME_PASS_PHRASE


# =========================================================
# EMAIL
# =========================================================

# Left unset on purpose: EMAIL_HOST/USERNAME/PASSWORD/SECURE are optional in
# config.validation.ts, but Joi rejects an empty string for a declared key
# (string "" and boolean "" both fail validation) — so unless email is being
# configured now, these must stay commented out rather than set to "".
#EMAIL_HOST=
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_SECURE=

# NOTE:
# This variable is named EMAIL_POET in the provided backend .env.example.
# Keep it until the backend source confirms whether this is intentional
# or a typo for EMAIL_PORT.
EMAIL_POET=


# =========================================================
# BUSINESS CONFIG
# =========================================================

INVOICE_CRYPTO_SECRET_KEY=CHANGE_ME_INVOICE_CRYPTO_SECRET

INVOICE_EXPIRY_ALERT_THRESHOLD=
PROCESS_WITHOUT_FILE_THRESHOLD=
ACTIVITY_CANCEL_STATUS=