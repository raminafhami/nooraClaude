# Frontend configuration. Copy to .env.local (local) or .env.production.local
# on the server. NEXT_PUBLIC_* values are inlined at build time, so the image
# must be rebuilt when they change.

# Public URL of this frontend.
NEXT_PUBLIC_APP_URL=https://erp.example.com
# Public URL of the backend API, as reached from the browser.
NEXT_PUBLIC_EXTERNAL_API_URL=https://api.erp.example.com
# Next.js route handlers on this app (not the Nest API). Keep it relative:
# it is only used from client components, so "/api" resolves against whatever
# origin serves the app and needs no per-environment value. A .env file does
# not expand variables, so "$NEXT_PUBLIC_APP_URL/api" would be sent literally.
NEXT_PUBLIC_INTERNAL_API_URL=/api

# Customer branding. Path is relative to /public.
NEXT_PUBLIC_CUSTOMER_LOGO=/images/customer-logo.png
NEXT_PUBLIC_CUSTOMER_NAME=

# OTP sign-in tab. This customer signs in with phone + password only.
NEXT_PUBLIC_ENABLE_OTP_LOGIN=false
