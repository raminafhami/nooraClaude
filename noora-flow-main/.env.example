# Backend configuration. Copy to .env (local) or .env.production (server) and
# fill in real values there. Never commit a filled-in copy.

# --- Application ---
APP_NAME=noora-flow
APP_ENV=production
APP_PORT=4000
APP_ENCRYPTION_SECRET=

# Origin of the public customer portal. The login flow compares the request
# Origin header against this value: `normal` users may only sign in from it,
# every other user type only from a different origin. Must match the real
# frontend URL or logins fail with "Invalid login".
CUSTOMER_NAITCO_URL=https://erp.example.com

# --- Swagger (/api_doc) ---
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# --- MongoDB ---
MONGO_URI=mongodb://noora-mongo:27017
MONGO_USER=
MONGO_PASS=
MONGO_DBNAME=noora_flow

# --- Redis ---
REDIS_HOST=noora-redis
REDIS_PORT=6379
REDIS_DB_INDEX=2

# --- Elasticsearch ---
ELASTIC_NODE=http://noora-elastic:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=
ELASTIC_API_KEY=

# --- JWT (expiry values are seconds) ---
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TOKEN_EXPIREIN=360000
JWT_REFRESH_TOKEN_EXPIREIN=8640000

# --- Admin seeding (npm run seed) ---
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=
# Seed automatically on boot. Leave false when running more than one replica
# and run `npm run seed` explicitly instead.
SEED_ADMIN_ON_STARTUP=false

# --- Feature flags ---
# false closes authentication/login-phone and authentication/verify.
OTP_LOGIN_ENABLED=false

# --- BPMN ---
BPMN_DEFINITIONS_PATH=
BPMN_TEMPLATE_PATH=

# --- Integrations (leave empty when unused) ---
SEPIDAR=
COMPANY_DISPATCHER_TYPE=
ALLOWED_IPS_PERSONNEL=
SMS_API_KEY=
SMS_URI=
RASMIO_API_KEY=
RASMIO_URL=
CURRENCY_API_KEY=
CURRENCY_API_URL=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=

# --- Bank gateway ---
IKC_PUBLIC_KEY=
TERMINAL_ID=
ACCEPTOR_ID=
REVERT_URI=
PASS_PHRASE=

# --- Email ---
EMAIL_HOST=
EMAIL_POET=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SECURE=

# --- Business thresholds ---
INVOICE_CRYPTO_SECRET_KEY=
INVOICE_EXPIRY_ALERT_THRESHOLD=
PROCESS_WITHOUT_FILE_THRESHOLD=
ACTIVITY_CANCEL_STATUS=
