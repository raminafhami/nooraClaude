# Server-side deployment configuration for docker-compose.prod.yml.
# Copy to .env on the server and fill in. Never commit the filled-in file.
# The backend container also receives this file via env_file, so it must
# additionally contain every variable from noora-flow-main/.env.example.

IMAGE_TAG=latest
FRONTEND_PORT=3000
BACKEND_PORT=4000

# --- Datastores ---
MONGO_USER=
MONGO_PASS=
MONGO_DBNAME=noora_flow
REDIS_DB_INDEX=2
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- Frontend build-time values (rebuild required when changed) ---
NEXT_PUBLIC_APP_URL=https://erp.example.com
NEXT_PUBLIC_EXTERNAL_API_URL=https://api.erp.example.com
NEXT_PUBLIC_INTERNAL_API_URL=/api
NEXT_PUBLIC_CUSTOMER_LOGO=/images/customer-logo.png
NEXT_PUBLIC_CUSTOMER_NAME=
NEXT_PUBLIC_ENABLE_OTP_LOGIN=false

# --- Admin seeding ---
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=
SEED_ADMIN_ON_STARTUP=false

# --- Feature flags ---
OTP_LOGIN_ENABLED=false

# Remaining backend variables (JWT_*, CUSTOMER_NAITCO_URL, SWAGGER_*, mail,
# SMS, bank gateway, ...) - see noora-flow-main/.env.example.
